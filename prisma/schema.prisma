generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DIRECTOR
  ADMIN
  TEACHER
  EXAMINER
  GUARDIAN
}

model User {
  id           String  @id @default(cuid())
  name         String
  username     String  @unique
  passwordHash String
  role         Role

  fatherName    String?
  motherName    String?
  familyName    String? // النسبة: الكنية أو اسم العائلة
  phone         String?
  birthDate     String?
  nationalId    String?
  address       String?
  currentJob    String?
  photoUrl      String?
  maritalStatus String?
  education     String?
  quranLevel    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // دور ولي الأمر فقط: كلمة المرور مخزَّنة مشفَّرة (قابلة للاسترجاع) لتظهر للإداريين في ملف الطالب
  guardianPasswordEnc String?

  teachableCohorts CohortTeacher[]
  halaqatTaught    Halqa[]
  auditLogs        AuditLog[]
  guardianOf       Student[]        @relation("StudentGuardianAccount")
  attendanceTaken  Attendance[]     @relation("AttendanceRecorder")
  recitationsTaken Recitation[]     @relation("RecitationRecorder")
  examsGiven       Exam[]           @relation("ExamsGiven")
  questions        Question[]
}

// الأفواج: خمسة صفوف ثابتة (لا تُضاف ولا تُحذف من الواجهة) تُزرع عند التهيئة.
model Cohort {
  id         String  @id
  name       String  @unique
  isRotating Boolean @default(false) // false = ثابت, true = قلّاب
  time1      String?
  time2      String? // قلّاب فقط
  // القلّاب يتناوب أسبوعًا بأسبوع؛ هذا التاريخ يحدد أي أسبوع هو الأول
  rotationStart String?

  teachers CohortTeacher[]
  halaqat  Halqa[]
}

model CohortTeacher {
  cohortId String
  userId   String
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cohortId, userId])
}

model Halqa {
  id        String @id @default(cuid())
  name      String
  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id])
  cohortId  String
  cohort    Cohort @relation(fields: [cohortId], references: [id])

  students    Student[]
  attendance  Attendance[]
  recitations Recitation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Student {
  id            String   @id @default(cuid())
  studentNo     Int      @unique
  name          String
  fatherName    String?
  motherName    String?
  birthDate     String?
  address       String?
  fatherJob     String?
  photoUrl      String?
  studentPhone  String?
  guardianPhone String?
  registeredAt  DateTime @default(now())

  halqaId String?
  halqa   Halqa?  @relation(fields: [halqaId], references: [id])

  // حساب ولي الأمر: اسم المستخدم = رقم الطالب، يُنشأ تلقائيًا عند التسجيل
  guardianUserId String? @unique
  guardianUser   User?   @relation("StudentGuardianAccount", fields: [guardianUserId], references: [id])

  attendance  Attendance[]
  recitations Recitation[]
  exams       Exam[]

  updatedAt DateTime @updatedAt
}

// صف وحيد (id ثابت = 1) يحمل أيام الدوام الرسمية.
model WorkingDays {
  id   Int    @id @default(1)
  days String // JSON array, e.g. ["السبت","الأحد","الاثنين"]
}

model Holiday {
  id   String @id @default(cuid())
  name String
  date String
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  createdAt DateTime @default(now())
}

// ==================== المرحلة ٢: العمل اليومي ====================

enum AttendanceStatus {
  PRESENT // حاضر
  LATE // متأخر
  EXCUSED // إذن
  ABSENT // غائب
}

model Attendance {
  id      String           @id @default(cuid())
  date    String // YYYY-MM-DD
  status  AttendanceStatus

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  halqaId   String
  halqa     Halqa   @relation(fields: [halqaId], references: [id])

  recordedById String
  recordedBy   User   @relation("AttendanceRecorder", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@index([halqaId, date])
}

// ==================== المرحلة ٣: السبر والأسئلة ====================

enum ExamType {
  LOCAL // سبر محلي
  WAQF_NOMINATION // سبر ترشيح الأوقاف
  PLACEMENT // تحديد مستوى
}

enum EvalMode {
  MARK100 // علامة من 100
  GRADE // تقدير
  LEVEL // مستوى
}

// صف وحيد (id ثابت = 1) — شكل عرض نتيجة تحديد المستوى وترشيح الأوقاف، تضبطه الإدارة مرة واحدة.
model EvaluationSettings {
  id            Int      @id @default(1)
  placementMode EvalMode @default(MARK100)
  awqafMode     EvalMode @default(MARK100)
}

// بنك أسئلة — خاص بكل مختبِر على حدة، لا يُشارَك بين المختبِرين.
model Question {
  id         String   @id @default(cuid())
  text       String
  examinerId String
  examiner   User     @relation(fields: [examinerId], references: [id])
  createdAt  DateTime @default(now())

  answers ExamAnswer[]
}

model Exam {
  id   String   @id @default(cuid())
  type ExamType
  date String // YYYY-MM-DD

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  examinerId String
  examiner   User   @relation("ExamsGiven", fields: [examinerId], references: [id])

  // LOCAL: الجزء المختبَر فيه · PLACEMENT: الجزء الذي يبدأ منه الطالب (نتيجة الفرز)
  juz Int?

  // نتيجة PLACEMENT وWAQF_NOMINATION حسب الوضع المضبوط في EvaluationSettings وقت الحفظ
  resultMark  Int?
  resultGrade String?
  resultLevel String?

  // LOCAL فقط — محسوبة تلقائيًا: متوسط علامات الأسئلة × ١٠
  localTotal Int?

  // WAQF_NOMINATION فقط
  nominationPresent Boolean? // true = حاضرًا, false = غيبًا
  nominationParts   Int?

  notes String?

  answers ExamAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([examinerId])
}

// سطر سؤال واحد ضمن سبر محلي
model ExamAnswer {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  mark       Int // من ١٠
}

model Recitation {
  id   String @id @default(cuid())
  date String // YYYY-MM-DD

  none   Boolean @default(false) // لم يسمّع اليوم إطلاقًا
  noNew  Boolean @default(false) // لم يسمّع جديدًا
  noPast Boolean @default(false) // لم يقرأ ماضيًا

  newFrom  Int? // صفحات المصحف: ١–٦٠٤
  newTo    Int?
  pastFrom Int?
  pastTo   Int?

  gradeNew  String? // ممتاز | جيد جدًا | جيد | ضعيف | إعادة
  gradePast String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  halqaId   String
  halqa     Halqa   @relation(fields: [halqaId], references: [id])

  recordedById String
  recordedBy   User   @relation("RecitationRecorder", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@index([halqaId, date])
}
