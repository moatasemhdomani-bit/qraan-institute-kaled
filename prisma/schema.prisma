generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// نوع التدريس: القرآن الكريم، أو كتاب «مختصر القراءة العربية» (صفحاته 5–48)
// مستويات الطالب بالترتيب: قراءة عربية ← عمَّ غيباً ← قرآن حاضراً ← قرآن غيباً ← متخرِّج.
// المدرّس والحلقة من الأربعة الأولى، والمختبِر QURAN (كل مستويات القرآن) أو ARABIC.
/** حالة رسوم الطالب. */
enum FeeStatus {
  PAID // تم الدفع
  UNPAID // لم يدفع
  REMAINING // متبقٍّ عليه مبلغ
}

enum Track {
  QURAN // قرآن حاضراً
  ARABIC // قراءة عربية
  AMMA // عمَّ غيباً
  QURAN_GHAIB // قرآن غيباً
  GRADUATED // متخرِّج — للطالب وحده
}

enum Role {
  DIRECTOR
  ADMIN
  TEACHER
  EXAMINER
  GUARDIAN
  EXAM_SUPERVISOR // مشرف مختبرين القرآن: شاشات مختبِر القرآن + متابعة الحضور والتسميع والسبر للاطلاع فقط
}

model User {
  id           String @id @default(cuid())
  name         String
  username     String @unique
  passwordHash String
  role         Role
  // للمدرّس والمختبِر: نوع ما يدرّسه/يسبره — لكل موظف نوع واحد
  track        Track  @default(QURAN)

  fatherName    String?
  motherName    String?
  familyName    String? // النسبة: الكنية أو اسم العائلة
  phone         String?
  birthDate     String?
  nationalId    String?
  address       String?
  currentJob    String?
  photoUrl      String?
  maritalStatus String?
  education     String?
  quranLevel    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // كلمة المرور مخزَّنة أيضًا مشفَّرة (قابلة للاسترجاع) لتظهر للإداريين — لكل الأدوار، وليس ولي الأمر وحده
  passwordEnc String?

  // حساب محذوف لكن مرتبط بسجلات سابقة (سبر أجراه، سجل تدقيق، …): لا يدخل ولا يظهر في القوائم، ويبقى اسمه في تلك السجلات
  deletedAt DateTime?
  // موظف معلَّق: لا يدخل (كالمحذوف) لكن تبقى بياناته الشخصية كاملة ويظهر في القائمة، ويمكن إلغاء تعليقه
  suspendedAt DateTime?

  teachableCohorts CohortTeacher[]
  assignments      StaffAssignment[]
  halaqatTaught    Halqa[]
  auditLogs        AuditLog[]
  guardianOf       Student[]       @relation("StudentGuardianAccount")
  attendanceTaken  Attendance[]    @relation("AttendanceRecorder")
  recitationsTaken Recitation[]    @relation("RecitationRecorder")
  examsGiven       Exam[]          @relation("ExamsGiven")
  permitsSet       Permit[]        @relation("PermitSetter")
  awqafBatchesMade AwqafBatch[]    @relation("AwqafBatchCreator")
  behaviorChangesMade StudentBehaviorLog[] @relation("BehaviorActor")
  reportsIssued    IssuedReport[]  @relation("ReportIssuer")
}

// الأفواج: خمسة صفوف ثابتة (لا تُضاف ولا تُحذف من الواجهة) تُزرع عند التهيئة.
model Cohort {
  id         String  @id
  name       String  @unique
  isRotating Boolean @default(false) // false = ثابت, true = قلّاب

  time1Start String? // HH:MM
  time1End   String? // HH:MM
  time2Start String? // قلّاب فقط
  time2End   String? // قلّاب فقط

  // القلّاب يتناوب أسبوعًا بأسبوع؛ هذا التاريخ يحدد أي أسبوع هو الأول
  rotationStart String?

  teachers    CohortTeacher[]
  halaqat     Halqa[]
  assignments StaffAssignment[]
}

// دور الموظف ونوعه في كل فوج — قد يختلف دوره باختلاف الأفواج (مدرس في فوج، مختبِر في آخر…).
// الأفواج ذات الدور والنوع نفسيهما تجتمع في حساب واحد يتنقّل بينه وبين حساباته الأخرى أعلى الشاشة.
// المدير والإداري صلاحياتهما على المعهد كاملًا أيًّا كان الفوج؛ المدرّس والمختبِر محصوران في أفواج حسابه.
model StaffAssignment {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  role     Role
  track    Track  @default(QURAN)

  @@unique([userId, cohortId])
}

model CohortTeacher {
  cohortId String
  userId   String
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cohortId, userId])
}

model Halqa {
  id        String @id @default(cuid())
  name      String
  track     Track  @default(QURAN) // مدرّسها وطلابها من النوع نفسه
  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id])
  cohortId  String
  cohort    Cohort @relation(fields: [cohortId], references: [id])

  students    Student[]
  attendance  Attendance[]
  recitations Recitation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Student {
  id            String   @id @default(cuid())
  studentNo     Int      @unique
  name          String
  fatherName    String?
  motherName    String?
  familyName    String? // النسبة: الكنية أو اسم العائلة
  birthDate     String?
  address       String?
  fatherJob     String?
  photoUrl      String?
  studentPhone  String?
  guardianPhone String?
  registeredAt  DateTime? @default(now()) // فارغ لطلاب مستوردين بلا تاريخ تسجيل في الجدول القديم

  halqaId String?
  halqa   Halqa?  @relation(fields: [halqaId], references: [id])

  // حساب ولي الأمر: اسم المستخدم = رقم الطالب، يُنشأ تلقائيًا عند التسجيل
  guardianUserId String? @unique
  guardianUser   User?   @relation("StudentGuardianAccount", fields: [guardianUserId], references: [id])

  // سلوك الطالب — افتراضيًا «ممتاز»، وأي تعديل يستوجب ملاحظة (StudentBehaviorLog) توضّح سببه.
  behavior String @default("ممتاز")
  // ملاحظة المدرّس الخاصة: ما يعمل على تصحيحه للطالب — تظهر للمدرّس وحده في شاشة التسميع، لا للإدارة ولا لولي الأمر
  teacherNote String?

  // حالة الطالب: نشط (افتراضيًا) أو منقطع — المنقطع يُخرَج من حلقته (فيغيب عن الحضور والتسميع اليوميين)
  // وتبقى بياناته الشخصية وكل سجلاته محفوظة
  active Boolean @default(true)

  // يتيم — غير مفعّل افتراضيًا؛ أساس فلتر «أيتام» وتقرير «الأيتام»
  isOrphan Boolean @default(false)
  // الرسوم: حالة الدفع والمبلغ (بالعملة الجديدة) — الطالب يبدأ «تم الدفع» (المبلغ اختياري)، و«متبقي» بمبلغه المتبقي
  feeStatus FeeStatus? @default(PAID)
  feeAmount Int?

  // قرآن أو قراءة عربية — يُفرز فقط في حلقة من نوعه
  track Track @default(QURAN)
  // تاريخ ترفّعه إلى مستوى جديد (أُخرج من حلقته لإعادة فرزه) — يميّزه في «غير المفروزين» عن الطالب الجديد
  promotedAt DateTime?

  attendance  Attendance[]
  recitations Recitation[]
  exams       Exam[]
  permits     Permit[]
  awqafResults AwqafResult[]
  behaviorLog StudentBehaviorLog[]
  teacherNotes TeacherMonthlyNote[]
  issuedReports IssuedReport[]

  updatedAt DateTime @updatedAt
}

// صف وحيد (id ثابت = 1) يحمل أيام الدوام الرسمية.
model WorkingDays {
  id   Int    @id @default(1)
  days String // JSON array, e.g. ["السبت","الأحد","الاثنين"]
}

model Holiday {
  id   String @id @default(cuid())
  name String
  date String
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  createdAt DateTime @default(now())
}

// ==================== المرحلة ٢: العمل اليومي ====================

enum AttendanceStatus {
  PRESENT // حاضر
  LATE // متأخر
  EXCUSED // إذن
  ABSENT // غائب
}

model Attendance {
  id     String           @id @default(cuid())
  date   String // YYYY-MM-DD
  status AttendanceStatus

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  halqaId   String
  halqa     Halqa   @relation(fields: [halqaId], references: [id])

  recordedById String
  recordedBy   User   @relation("AttendanceRecorder", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@index([halqaId, date])
}

enum PermitKind {
  ENTRY // إذن دخول
  EXIT // إذن خروج
}

// إذن دائم — يلازم الطالب في كل أيام الدوام حتى يُحذف (ليس سجلًا يوميًا كالحضور).
model Permit {
  id    String     @id @default(cuid())
  kind  PermitKind
  time  String // HH:MM بصيغة 24 ساعة
  note  String?
  since String // YYYY-MM-DD — تاريخ إضافته أول مرة، لا يتغيّر مع التعديل
  // أيام الإذن من أيام الدوام الرسمية (بأسمائها، مثل «السبت») — فارغة في الأذونات القديمة = كل أيام الدوام
  days  String[] @default([])

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  setById String
  setBy   User   @relation("PermitSetter", fields: [setById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, kind])
}

// ==================== المرحلة ٣: السبر والأسئلة ====================

enum ExamType {
  LOCAL // سبر محلي
  WAQF_NOMINATION // سبر ترشيح الأوقاف
  PLACEMENT // تحديد مستوى
  ARABIC // سبر مختصر القراءة العربية — بالمرحلة
}

// فروع السبر المحلي الثلاثة
enum LocalKind {
  GHAYBAN // غيباً — علامة واحدة فقط، بلا بنك أسئلة
  HADIRAN // حاضراً — بنك أسئلة التجويد حسب الجزء
  AMMA_GHAYBAN // عمّ غيباً — علامة واحدة فقط، بلا بنك أسئلة
}

// بنك أسئلة التجويد لسبر "حاضراً" — بداية من خطة المعلم، وقابل لتعديل أي مختبِر وإضافته إليه.
// عند اختيار جزء N يظهر كل سؤال بجزء ≤ N (تراكميًا).
model TajweedTopic {
  id    String @id @default(cuid())
  juz   Int
  text  String
  order Int    @default(0)

  answers ExamAnswer[]

  @@index([juz])
}

model Exam {
  id   String   @id @default(cuid())
  type ExamType
  date String // YYYY-MM-DD

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  examinerId String
  examiner   User   @relation("ExamsGiven", fields: [examinerId], references: [id])

  // LOCAL فقط — أي فرع من الفروع الثلاثة
  localKind LocalKind?

  // PLACEMENT: الجزء الذي يبدأ منه الطالب (نتيجة الفرز، بلا علامة)
  // LOCAL/HADIRAN وLOCAL/GHAYBAN: الجزء الذي سُبر فيه (لا يوجد لعمّ غيباً — دائمًا جزء عمّ)
  juz Int?

  // PLACEMENT بالقراءة العربية: الصفحة التي يبدأ منها الطالب في «مختصر القراءة العربية» (5–48) بدل الجزء
  startPage Int?

  // LOCAL (الأنواع الثلاثة) وWAQF_NOMINATION — أرقام صفحات مفردة، غير متتالية بالضرورة
  pages Int[] @default([])

  // WAQF_NOMINATION، وLOCAL (الأنواع الثلاثة) — علامة من 100، يُدخلها المختبِر مباشرةً
  resultMark Int?
  // نتيجة السبر «إعادة» (بدل «راسب»): يختار المختبِر «ناجح» أو «إعادة» أولًا — للإعادة لا علامة، وللنجاح علامة ضمن علامات النجاح
  repeat Boolean @default(false)

  // WAQF_NOMINATION وPLACEMENT
  nominationPresent Boolean? // true = حاضرًا, false = غيبًا
  nominationParts   Int?

  // ARABIC فقط: المرحلة 1–6؛ المراحل 1–5 بتقدير (ممتاز/جيد جدًا/جيد/إعادة)، والمرحلة 6 بعلامة من 100 (resultMark)
  stage Int?
  grade String?

  notes String?

  answers ExamAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([examinerId])
}

// سطر سؤال واحد ضمن سبر محلي (حاضراً فقط) — أيّ بند من بنك أسئلة التجويد غُطِّي في هذا السبر
// (توثيق فقط، بلا علامة — العلامة الكلية يُدخلها المختبِر مباشرةً في Exam.resultMark)
model ExamAnswer {
  id      String       @id @default(cuid())
  examId  String
  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  topicId String
  topic   TajweedTopic @relation(fields: [topicId], references: [id])
}

// ==================== المرحلة ٤: سبر الأوقاف والشهادات ====================

// دفعة سبر أوقاف: حدث جماعي بتاريخ واحد، يضم عدة طلاب اختارهم الإداري معًا.
// الاختبار نفسه يقع خارج النظام بالكامل (جهة الأوقاف) — الدفعة تُدار قبله (اختيار من رشّحهم) وبعده (العلامات ودورة الشهادة).
model AwqafBatch {
  id   String @id @default(cuid())
  date String // YYYY-MM-DD

  createdById String
  createdBy   User   @relation("AwqafBatchCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  // أرشفة الشهادات بملف واحد لكل الدفعة (بديل عن ملف لكل طالب، أو إضافة إليه)
  certFileUrl String?

  results AwqafResult[]
}

// نتيجة طالب واحد ضمن دفعة: علامته، ثم — إن نجح — دورة شهادته الثلاثية.
model AwqafResult {
  id        String     @id @default(cuid())
  batchId   String
  batch     AwqafBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId String
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  score Int? // علامة من 100 — تصل من جهة الأوقاف، تُدخلها الإدارة بعد الاختبار

  // حاضرًا (تلاوة، حدّ النجاح 90) أو غيبًا (حفظ، حدّ النجاح 80) — لقطة من مسار ترشيحه وقت إضافته للدفعة
  nominationPresent Boolean

  // دورة الشهادة — تسلسل تصاعدي القفل، للناجح فقط (تبقى false لمن رسب)
  certArrived   Boolean @default(false)
  certArchived  Boolean @default(false)
  certFileUrl   String?
  certDelivered Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([batchId, studentId])
  @@index([studentId])
}

model Recitation {
  id   String @id @default(cuid())
  date String // YYYY-MM-DD

  none   Boolean @default(false) // لم يسمّع اليوم إطلاقًا
  noNew  Boolean @default(false) // لم يسمّع جديدًا
  noPast Boolean @default(false) // لم يقرأ ماضيًا

  newFrom Int? // صفحات المصحف: ١–٦٠٤
  newTo   Int?

  gradeNew String? // ممتاز | جيد جدًا | جيد | ضعيف | إعادة

  // الماضي لطلاب القرآن بالأجزاء والأحزاب: [{ kind: HIZB1|HIZB2|JUZ, juz: 1–30, grade }] — انظر lib/pastRecitation.ts
  pastItems Json @default("[]")

  // تسميع بالسور (عمَّ غيباً، وطالب القراءة العربية بعد المرحلة 6 — «بينة للناس»): السور المسمَّعة بدل أرقام الصفحات
  surahs String[] @default([])

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  halqaId   String
  halqa     Halqa   @relation(fields: [halqaId], references: [id])

  recordedById String
  recordedBy   User   @relation("RecitationRecorder", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@index([halqaId, date])
}

// ==================== المرحلة ٥: التقارير ====================

// سجل تغييرات سلوك الطالب — كل تغيير عن «ممتاز» (أو عودة إليها) يستوجب ملاحظة.
model StudentBehaviorLog {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  previousValue String
  newValue      String
  note          String

  actorId String
  actor   User   @relation("BehaviorActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([studentId])
}

// ملاحظة شهرية يكتبها مدرّس الحلقة عن طالب واحد — تصل جاهزة (وقابلة للتعديل) إلى عمود
// الملاحظات في تقرير تسميع الحلقات عندما يغطّي التقرير هذا الشهر.
model TeacherMonthlyNote {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month     String // "YYYY-MM"
  note      String

  updatedAt DateTime @updatedAt

  @@unique([studentId, month])
}

enum ReportKind {
  HALAQAT // تقرير تسميع حلقات القرآن
  TEACHERS // التقرير الشهري لمدرسي القرآن
  HALAQAT_AR // تقرير تسميع حلقات القراءة العربية
  TEACHERS_AR // التقرير الشهري لمدرسي القراءة العربية
  STUDENT // تقرير طالب
  AWQAF_MARKS // علامات سبر الأوقاف — لدفعة واحدة
  ORPHANS // الأيتام — قائمة أسماء الطلاب الأيتام
}

// سجل التقارير الصادرة — لا يحمل ملف PDF مخزَّنًا؛ يُعاد توليد التقرير عند الطلب من هذه المعطيات نفسها.
model IssuedReport {
  id         String     @id @default(cuid())
  kind       ReportKind
  name       String
  fromDate   String // YYYY-MM-DD
  toDate     String // YYYY-MM-DD
  paramsJson String // معطيات خاصة بنوع التقرير (halqaScope + notesJson لتقرير الحلقات، "{}" لغيره)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])

  issuedById String
  issuedBy   User   @relation("ReportIssuer", fields: [issuedById], references: [id])

  createdAt DateTime @default(now())

  @@index([kind])
}
