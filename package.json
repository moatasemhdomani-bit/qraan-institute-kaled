{
  "name": "khaled-institute",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "prisma migrate deploy && node prisma/seed.mjs && next start",
    "start:plain": "next start",
    "lint": "eslint",
    "db:seed": "node prisma/seed.mjs",
    "db:start": "pgtools\\pgsql\\bin\\pg_ctl.exe -D pgtools/data -l pgtools/pg.log start",
